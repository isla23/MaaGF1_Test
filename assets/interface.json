{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"name": "300",
	"interface_version": 2,
	"version": "v2.0.0-beta.2",
	"controller": [
		{"name": "模拟器", "type": "Adb"}
	],
	"resource": [
		{
			"name": "官服",
			"path": ["{PROJECT_DIR}/resource/"]
		}
	],
	"languages": {
		"zh-CN": "./resource/lang.zh-CN.json",
		"en-US": "./resource_en/lang.en-US.json"
	},
	"task": [
		{
			"name": "1.经验 - 13-4地图初始化",
			"entry": "attack",
			"check": false,
			"repeatable": false,
			"repeat_count": -1
		},
		{"name": "300魔王", "entry": "where"},
		{
			"name": "300赛贝斯",
			"entry": "where",
			"repeatable": true,
			"repeat_count": -1,
			"option": [
				"塞北似",
				"房间相关",
				"是否开启活互动任务",
				"英雄选择",
				"是否一直释放skill"
			]
		},
		{
			"name": "人机",
			"entry": "where",
			"repeatable": true,
			"option": ["人机"]
		},
		{
			"name": "大zc",
			"entry": "大战场",
			"repeatable": true
		}
	],
	"option": {
		"塞北似": {
			"cases": [
				{
					"name": "1",
					"pipeline_override": {
						"where": {
							"post_delay": 3000,
							"rate_limit": 3000,
							"timeout": 900000,
							"next": [
								"if_ocr_zibao",
								"if_incombat",
								"startmatch",
								"识别战果"
							]
						}
					}
				}
			]
		},
		"英雄选择": {
			"type": "select",
			"default_case": "赛贝斯",
			"cases": [
				{
					"name": "赛贝斯",
					"pipeline_override": {}
				},
				{
					"name": "莉亚",
					"pipeline_override": {
						"choosehero_z_1": {
							"next": [
								"choosehero_z_tank"
							]
						},
						"saibeisi_ok": {
							"next": [
								"if_ly",
								"[JumpBack]saibeisi_"
							]
						}
					}
				},
				{
					"name": "同",
					"pipeline_override": {
						"choosehero_z_1": {
							"next": [
								"choosehero_z_ap"
							]
						},
						"saibeisi_ok": {
							"next": [
								"if_tong",
								"[JumpBack]saibeisi_"
							]
						}
					}
				}
			]
		},
		"是否一直释放skill": {
			"type": "switch",
			"default_case": "No",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"if_incombat": {
							"next": [
								"识别时间9分",
								"识别时间10分",
								"[Anchor]W"
							]
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {}
				}
			]
		},
		"房间相关": {
			"type": "select",
			"description": "1",
			"default_case": "无组队",
			"cases": [
				{
					"name": "无组队",
					"description": "无",
					"pipeline_override": {}
				},
				{
					"name": "双人房主",
					"description": "需要等待队员",
					"pipeline_override": {
						"startmatch": {
							"next": [
								"队长模式",
								"startmatch"
							]
						}
					}
				},
				{
					"name": "三人房主",
					"description": "需要等待队员",
					"pipeline_override": {
						"队长模式": {
							"roi": [543, 294, 44, 29],
							"post_delay": 6000,
							"rate_limit": 6000
						}
					}
				},
				{
					"name": "队员",
					"description": "直接识别选英雄界面",
					"pipeline_override": {
						"startmatch": {
							"next": [
								"队员模式",
								"choosehero_z_1"
							]
						}
					}
				}
			]
		},
		"是否开启活互动任务": {
			"type": "select",
			"default_case": "仅语音",
			"cases": [
				{
					"name": "仅语音",
					"pipeline_override": {
						"news2": {
							"post_delay": 5000,
							"next": [
								"zibao"
							]
						},
						"news2_1": {
							"post_delay": 5000,
							"next": [
								"zibao"
							]
						}
					}
				},
				{
					"name": "语音+道具",
					"pipeline_override": {}
				},
				{
					"name": "无",
					"pipeline_override": {
						"if_zibao": {
							"next": [
								"识别时间10分",
								"where"
							]
						}
					}
				}
			]
		},
		"人机": {
			"cases": [
				{
					"name": "人机",
					"pipeline_override": {
						"Clickstartbattle_1": {
							"next": [
								"点击人机"
							]
						},
						"move": {
							"next": [
								"点击设置"
							]
						}
					}
				}
			]
		}
	}
}